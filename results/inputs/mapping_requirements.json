  "source_run": {"schema_version": 2, "tool": "meridian-parser 0.2.0", "generated_at": "2026-08-23T01:55:00+00:00", "input_dir": "<REPO_ROOT>/rainbow_keys", "git_commit": "44e622551ef8f0a9c031707faf111a6a98d7263c", "python": "3.14.5"},
