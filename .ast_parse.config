# Meridian AST Parser — exclusions for this repository.
#
# Patterns are fnmatch globs matched against the BASE NAME of an entry, not the
# full path, so `node_modules` matches at any depth. Blank lines and lines
# beginning with `#` are ignored.
#
# This file EXTENDS the built-in defaults, which already skip hidden
# directories, virtualenvs, node_modules, site-packages, build output and tool
# caches. Only project-specific entries belong here. To walk a directory the
# defaults exclude, name it under [include_dirs] — that section wins.
#
# Run with --no-config to ignore this file entirely, or --config PATH to use a
# different one.
#
# The design specification's own rules are separate and always apply: files
# matching `test_*.py` and directories whose name is or begins with `test` are
# skipped whatever this file says.

[exclude_dirs]

# This repository's own non-source trees. (.orchestrator is already covered by
# the default hidden-directory rule; it is listed here for the reader.)
.orchestrator
plans
design
throwaway

[exclude_files]

# Nothing excluded by file name here yet. The `test_*.py` rule from the design
# specification is applied separately and does not need listing.

[include_dirs]

# Nothing re-enabled. Add a directory name here only when a built-in default
# excludes something this project genuinely needs parsed.
