  "requirements": [
    {"code": "1", "text": "Sound", "is_category": true, "category_leak": false, "code_blocks": [], "children": [{"code": "1-1", "text": "Key-to-Note Mapping Ten playable keys \u2014 A, S, D, F, G and J, K, L, ;, ' \u2014 each map to one note of a major pentatonic scale, in ascending pitch order from left to right. The second group (J through ') sounds one octave above the first.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "91eed18d1cf2", "dotted_name": "python.key_mapping.key_order", "signature": "def key_order() -> tuple[str, ...]", "file_path": "python/key_mapping.py", "line_number": 64, "end_line": 66}, {"unit_id": "49f098c7f77f", "dotted_name": "python.key_mapping.frequency_for_key", "signature": "def frequency_for_key(key: str) -> float", "file_path": "python/key_mapping.py", "line_number": 69, "end_line": 71}], "children": []}, {"code": "1-2", "text": "Note Lifetime A note starts sounding on key-down and stops on key-up. Holding a key sustains its note; no re-pressing is required.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "e131d04fbb6e", "dotted_name": "python.audio_logic.NoteEngine.key_down", "signature": "def key_down(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 100, "end_line": 112}, {"unit_id": "ebf2a81ddbb1", "dotted_name": "python.audio_logic.NoteEngine.key_up", "signature": "def key_up(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 114, "end_line": 130}], "children": []}, {"code": "1-3", "text": "Polyphony Limit At most 3 notes sound simultaneously. A key pressed while 3 notes are sounding waits (if still held) and begins sounding as soon as a slot frees.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "e131d04fbb6e", "dotted_name": "python.audio_logic.NoteEngine.key_down", "signature": "def key_down(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 100, "end_line": 112}, {"unit_id": "ebf2a81ddbb1", "dotted_name": "python.audio_logic.NoteEngine.key_up", "signature": "def key_up(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 114, "end_line": 130}], "children": []}, {"code": "1-4", "text": "Latency Audible output begins within 20 ms of a key press, with no clicks or pops at note start or stop.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "f046b88d59ff", "dotted_name": "python.audio_logic._Voice.note_off", "signature": "def note_off(self) -> None", "file_path": "python/audio_logic.py", "line_number": 43, "end_line": 44}, {"unit_id": "f5f6aafb5968", "dotted_name": "python.audio_logic._Voice.render", "signature": "def render(self, frame_count: int) -> np.ndarray", "file_path": "python/audio_logic.py", "line_number": 46, "end_line": 62}, {"unit_id": "e131d04fbb6e", "dotted_name": "python.audio_logic.NoteEngine.key_down", "signature": "def key_down(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 100, "end_line": 112}, {"unit_id": "ebf2a81ddbb1", "dotted_name": "python.audio_logic.NoteEngine.key_up", "signature": "def key_up(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 114, "end_line": 130}], "children": []}]},
    {"code": "2", "text": "Visual Feedback", "is_category": true, "category_leak": false, "code_blocks": [], "children": [{"code": "2-1", "text": "Key Display All 10 playable keys are shown on screen in physical keyboard order, each in its assigned color, with a visible gap between the two octave groups.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "28faeb62248a", "dotted_name": "python.tui.main", "signature": "def main() -> None", "file_path": "python/tui.py", "line_number": 56, "end_line": 93}], "children": []}, {"code": "2-2", "text": "Pressed-Key Highlight While a key's note is sounding, its on-screen element is visibly highlighted; it returns to normal when the note stops. A key waiting on the polyphony limit (1.3) is not highlighted until it actually sounds.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "e131d04fbb6e", "dotted_name": "python.audio_logic.NoteEngine.key_down", "signature": "def key_down(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 100, "end_line": 112}, {"unit_id": "ebf2a81ddbb1", "dotted_name": "python.audio_logic.NoteEngine.key_up", "signature": "def key_up(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 114, "end_line": 130}, {"unit_id": "1e58d228707f", "dotted_name": "python.bridge_server.run", "signature": "def run() -> None", "file_path": "python/bridge_server.py", "line_number": 46, "end_line": 68}, {"unit_id": "28faeb62248a", "dotted_name": "python.tui.main", "signature": "def main() -> None", "file_path": "python/tui.py", "line_number": 56, "end_line": 93}], "children": []}, {"code": "2-3", "text": "Colors Keys are colored following the ROYGBIV sequence, repeating as needed, assigned left to right.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "db835681b862", "dotted_name": "python.key_mapping.color_for_key", "signature": "def color_for_key(key: str) -> str", "file_path": "python/key_mapping.py", "line_number": 74, "end_line": 76}], "children": []}]},
    {"code": "3", "text": "Interfaces", "is_category": true, "category_leak": false, "code_blocks": [], "children": [{"code": "3-1", "text": "Graphical Interface The primary interface is a native macOS window rendering the key display per section 2.", "is_category": false, "category_leak": false, "code_blocks": [], "children": []}, {"code": "3-2", "text": "Text Interface (TUI) A text-only terminal interface offers the same instrument: it plays sound when user presses keys, and highlights via TUI to show the end user which key is pressed. It reuses the same sound logic as the graphical interface; only presentation differs.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "28faeb62248a", "dotted_name": "python.tui.main", "signature": "def main() -> None", "file_path": "python/tui.py", "line_number": 56, "end_line": 93}], "children": []}, {"code": "3-3", "text": "TUI Release Approximation Because terminals do not report key-release events, the TUI may treat a key as released after a short interval (\u2264 0.6 s) without auto-repeat input for it. This is the only permitted deviation from 1.2.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "28faeb62248a", "dotted_name": "python.tui.main", "signature": "def main() -> None", "file_path": "python/tui.py", "line_number": 56, "end_line": 93}], "children": []}, {"code": "3-4", "text": "Quit The TUI exits cleanly on `q`, restoring the terminal state and silencing all notes.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "28faeb62248a", "dotted_name": "python.tui.main", "signature": "def main() -> None", "file_path": "python/tui.py", "line_number": 56, "end_line": 93}, {"unit_id": "d9ae1d90c595", "dotted_name": "python.audio_logic.NoteEngine.close", "signature": "def close(self) -> None", "file_path": "python/audio_logic.py", "line_number": 96, "end_line": 98}], "children": []}]},
    {"code": "4", "text": "Non-Functional", "is_category": true, "category_leak": false, "code_blocks": [], "children": [{"code": "4-1", "text": "Shared Logic Note mapping, polyphony, and synthesis live in a single logic layer shared by all interfaces; interfaces only report raw key transitions and render the resulting state.", "is_category": false, "category_leak": false, "code_blocks": [{"unit_id": "f046b88d59ff", "dotted_name": "python.audio_logic._Voice.note_off", "signature": "def note_off(self) -> None", "file_path": "python/audio_logic.py", "line_number": 43, "end_line": 44}, {"unit_id": "f5f6aafb5968", "dotted_name": "python.audio_logic._Voice.render", "signature": "def render(self, frame_count: int) -> np.ndarray", "file_path": "python/audio_logic.py", "line_number": 46, "end_line": 62}, {"unit_id": "e131d04fbb6e", "dotted_name": "python.audio_logic.NoteEngine.key_down", "signature": "def key_down(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 100, "end_line": 112}, {"unit_id": "ebf2a81ddbb1", "dotted_name": "python.audio_logic.NoteEngine.key_up", "signature": "def key_up(self, key: str) -> None", "file_path": "python/audio_logic.py", "line_number": 114, "end_line": 130}, {"unit_id": "49f098c7f77f", "dotted_name": "python.key_mapping.frequency_for_key", "signature": "def frequency_for_key(key: str) -> float", "file_path": "python/key_mapping.py", "line_number": 69, "end_line": 71}], "children": []}, {"code": "4-2", "text": "Dependencies The Python layer requires only NumPy and sounddevice; the TUI requires no additional packages or macOS permissions.", "is_category": false, "category_leak": false, "code_blocks": [], "children": []}]}
